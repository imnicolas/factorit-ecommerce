{
  "info": {
    "name": "ms-ecommerce",
    "description": "Colección REST del backend e-commerce. Incluye gestión de carritos, clientes (con búsqueda paginada y reportes VIP por mes) y productos.\n\nVariable `baseUrl` por defecto apunta a `http://localhost:8080`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Carritos",
      "item": [
        {
          "name": "Buscar carritos (paginado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/carritos?anio=2026&mes=5&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "carritos"],
              "query": [
                { "key": "carritoId", "value": "", "description": "ID exacto (opcional)", "disabled": true },
                { "key": "clienteId", "value": "", "description": "ID cliente (opcional)", "disabled": true },
                { "key": "anio", "value": "2026" },
                { "key": "mes", "value": "5" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            },
            "description": "Lista carritos ordenados por id desc. Excluye DESTRUIDO. Filtros opcionales: carritoId, clienteId, anio, mes."
          }
        },
        {
          "name": "Crear carrito",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/carritos?fechaSimulada=2026-05-14",
              "host": ["{{baseUrl}}"],
              "path": ["api", "carritos"],
              "query": [
                { "key": "fechaSimulada", "value": "2026-05-14", "description": "yyyy-MM-dd (opcional, default: hoy)" }
              ]
            },
            "description": "Crea un carrito para el cliente. Tipo (COMUN/FECHA_ESPECIAL/VIP) se determina automáticamente."
          }
        },
        {
          "name": "Consultar carrito por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/carritos/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "carritos", "1"]
            }
          }
        },
        {
          "name": "Eliminar carrito",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/carritos/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "carritos", "1"]
            },
            "description": "Elimina físicamente el carrito (solo si está ABIERTO)."
          }
        },
        {
          "name": "Agregar producto al carrito",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productoId\": 1,\n  \"cantidad\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/carritos/1/productos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "carritos", "1", "productos"]
            }
          }
        },
        {
          "name": "Eliminar producto del carrito",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/carritos/1/productos/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "carritos", "1", "productos", "1"],
              "query": [
                { "key": "cantidad", "value": "", "description": "Si se indica, reduce esa cantidad. Sino, elimina completo.", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Finalizar compra",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/carritos/1/finalizar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "carritos", "1", "finalizar"]
            },
            "description": "Completa la compra del carrito. Si el cliente supera $10.000 en el mes, se promueve a VIP."
          }
        }
      ]
    },
    {
      "name": "Clientes",
      "item": [
        {
          "name": "Buscar clientes (paginado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/clientes?search=&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clientes"],
              "query": [
                { "key": "search", "value": "", "description": "Búsqueda parcial en nombre, apellido o DNI" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            },
            "description": "Ordenado alfabético (nombre, apellido)."
          }
        },
        {
          "name": "VIPs del mes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/clientes/vip?anio=2026&mes=5&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clientes", "vip"],
              "query": [
                { "key": "anio", "value": "2026" },
                { "key": "mes", "value": "5" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            },
            "description": "Clientes cuya SUM(carritos COMPLETADO en el mes).total > $10.000."
          }
        },
        {
          "name": "Nuevos VIP del mes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/clientes/vip/nuevos?anio=2026&mes=5&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clientes", "vip", "nuevos"],
              "query": [
                { "key": "anio", "value": "2026" },
                { "key": "mes", "value": "5" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            },
            "description": "Clientes que son VIP en (anio, mes) y NO eran VIP en el mes anterior."
          }
        },
        {
          "name": "Perdieron VIP en el mes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/clientes/vip/perdieron?anio=2026&mes=5&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clientes", "vip", "perdieron"],
              "query": [
                { "key": "anio", "value": "2026" },
                { "key": "mes", "value": "5" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            },
            "description": "Clientes que eran VIP en el mes anterior y NO son VIP en (anio, mes)."
          }
        }
      ]
    },
    {
      "name": "Productos",
      "item": [
        {
          "name": "Listar productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos"]
            },
            "description": "Devuelve el catálogo completo ordenado por nombre."
          }
        }
      ]
    }
  ]
}
